\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Comparison of diffusion decoding strategies.} \textbf  {(a) Fixed-Length Denoising (Baseline):} Standard masked diffusion processes the full context window $L_c$ for all denoising steps. \textbf  {(b) SMARTCROP:} Our method performs an initial forward pass to extract EoS logits, computes cumulative probability Pr($L^* \leq \ell $), identifies predicted length $\hat  {L}$ at threshold $\tau $, and crops the context before denoising begins. This one-shot adjustment eliminates computational waste while maintaining output quality.}}{1}{}\protected@file@percent }
\newlabel{fig:method}{{1}{1}{}{figure.1}{}}
\gdef \@abspage@last{1}
